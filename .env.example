# Copy to .env on your own computer. Never commit .env or real credentials.
# Default is OpenAI. Other providers must implement Responses image_generation.
TILE_API_BASE_URL=https://api.openai.com/v1
TILE_API_KEY=
# Choose a model available to your API account that supports image generation.
TILE_API_MODEL=
# Optional image tool model. Leave blank if your provider selects it.
TILE_IMAGE_MODEL=
